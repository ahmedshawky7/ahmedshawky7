% Resume template based on the supplied Jake Gutierrez / sb2nov design.
\documentclass[letterpaper,11pt]{article}
\usepackage{latexsym}
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage{xcolor}
\usepackage[colorlinks=true,urlcolor=blue,linkcolor=blue]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\input{glyphtounicode}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}
\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}
\titleformat{\section}{
  \vspace{-6pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]
\pdfgentounicode=1
\newcommand{\resumeItem}[1]{\item\small{ #1}}
\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
  \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
    \textbf{ #1} & #2 \\
    \textit{\small #3} & \textit{\small #4} \\
  \end{tabular*}\vspace{-4pt}
}
\newcommand{\resumeProjectHeading}[2]{
  \item
  \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
    \small #1 & #2 \\
  \end{tabular*}\vspace{-2pt}
}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}
\newcommand{\resumeSubHeadingListStart}{
  \begin{itemize}[leftmargin=0.15in,label={},itemsep=2pt,parsep=0pt,topsep=0pt,partopsep=0pt]
}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{
  \begin{itemize}[leftmargin=0.18in,itemsep=1pt,parsep=0pt,topsep=1pt,partopsep=0pt]
}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{1pt}}
\begin{document}
\begin{center}
  \textbf{\Huge \scshape {{ personal.name|tex }}} \\[8pt]
  \small
  {{ personal.phone|tex }} $|$
  \href{mailto:{{ personal.email|tex }}}{\underline{ {{ personal.email|tex }} }}
  $|$
  \href{ {{ personal.linkedin|url }}}{\underline{LinkedIn}}
  $|$
  \href{ {{ personal.github|url }}}{\underline{GitHub}}
  {% if include_portfolio %}
  $|$
  \href{ {{ personal.portfolio|url }}}{\underline{Portfolio}}
  {% endif %}
\end{center}
\vspace{-4pt}
\section{Summary}
\small{
{{ profile.summary|tex }}
}
\section{Experience}
\resumeSubHeadingListStart
  \resumeSubheading
    { {{ experience.organization|tex }} }{ {{ experience.location|tex }} }
    { {{ profile.experience_title|tex }} }{ {{ experience.period|tex }} }
  \resumeItemListStart
  {% for bullet in experience.bullets %}
    \resumeItem{ {{ bullet|tex }} }
  {% endfor %}
  \resumeItemListEnd
\resumeSubHeadingListEnd
\section{Education}
\resumeSubHeadingListStart
  \resumeSubheading
    { {{ education.university|tex }} }{ {{ education.location|tex }} }
    { {{ education.degree|tex }} }{ {{ education.period|tex }} }
  \resumeItemListStart
    \resumeItem{ {{ education.courses|tex }} }
    \resumeItem{ {{ education.graduation_project|tex }} }
  \resumeItemListEnd
\resumeSubHeadingListEnd
\section{Projects}
\resumeSubHeadingListStart
{% for project in profile.projects %}
  \resumeProjectHeading
    {\textbf{ {{ project.name|tex }} } $|$ \emph{
    {% for link in project.links %}
      {% if not loop.first %} $|$ {% endif %}
      \href{ {{ link.url|url }}}{\underline{ {{ link.label|tex }} }}
    {% endfor %}
    }}{}
  \resumeItemListStart
  {% for bullet in project.bullets %}
    \resumeItem{ {{ bullet|tex }} }
  {% endfor %}
  \resumeItemListEnd
  {% if not loop.last %}\vspace{1pt}{% endif %}
{% endfor %}
\resumeSubHeadingListEnd
\section{Technical Skills}
\begin{itemize}[leftmargin=0.15in,label={},itemsep=1pt,parsep=0pt,topsep=1pt]
\small{\item{
{% for skill in profile.skills %}
  \textbf{ {{ skill[0]|tex }} }{: {{ skill[1]|tex }}}{% if not loop.last %} \\{% endif %}
{% endfor %}
}}
\end{itemize}
\section{Languages}
\small{
{% for language in languages %}
  {{ language|tex }}{% if not loop.last %} $|$ {% endif %}
{% endfor %}
}
\end{document}
